# ─────────────────────────────────────────────────
# IMT Projet Ouvert — Variables d'environnement
# Copier ce fichier en `.env` puis renseigner les valeurs réelles.
# ─────────────────────────────────────────────────

# Base de données Neon PostgreSQL
# DATABASE_URL : connexion poolée (PgBouncer) utilisée par l'application
# DIRECT_URL   : connexion directe, utilisée par `prisma db push`
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# NextAuth.js (v5) — le secret signe les JWT de session
AUTH_SECRET="your-auth-secret-here"
NEXTAUTH_SECRET="your-auth-secret-here"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Neon Object Storage (S3-compatible, bucket privé « uploads »)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION="eu-central-1"

# Indication de la branche Neon ciblée (documentaire)
NEON_BRANCH="production"
